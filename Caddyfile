# ----------------------------------------------------------------
#  NetFleet — Caddy reverse proxy
#  · Auto-HTTPS via Let's Encrypt (provide a real domain in .env)
#  · HTTP/2 + HTTP/3 enabled
#  · API at /api/*, Web everywhere else
# ----------------------------------------------------------------

# ACME challenge, chosen by NETFLEET_ACME_DNS in .env:
#   (empty)     HTTP-01 / TLS-ALPN-01. The host must be reachable from the
#               internet on :80/:443.
#   cloudflare  DNS-01 through the Cloudflare API, for deployments whose
#               public DNS record points at a private address. Needs
#               NETFLEET_CLOUDFLARE_API_TOKEN (Zone / DNS / Edit).
# Caddy normally confirms the TXT record by asking the zone's authoritative
# nameservers directly on port 53. Internal hosts often have outbound DNS
# blocked, so that check is off by default and Caddy waits a fixed delay
# instead. See docs/installation.md.
(acme_default) {
}

(acme_cloudflare) {
	tls {
		dns cloudflare {env.NETFLEET_CLOUDFLARE_API_TOKEN}
		propagation_delay {$NETFLEET_ACME_PROPAGATION_DELAY:60s}
		propagation_timeout {$NETFLEET_ACME_PROPAGATION_TIMEOUT:-1}
	}
}

{
	# Global options
	email admin@{$NETFLEET_DOMAIN}
	servers {
		protocols h1 h2 h3
	}
}

{$NETFLEET_DOMAIN} {
	import acme_{$NETFLEET_ACME_DNS:default}

	encode zstd gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API — REST + WebSocket (FastAPI)
	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			# WebSocket support
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
		rewrite * /api{uri}
	}

	# OpenAPI / Swagger UI
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /redoc* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Everything else → Next.js
	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
		level INFO
	}
}

# Optional: local-dev mode (no TLS, plain HTTP on :80)
# Uncomment the block below if NETFLEET_DOMAIN is "localhost"
#
# :80 {
#     handle_path /api/* {
#         reverse_proxy api:8000
#     }
#     handle {
#         reverse_proxy web:3000
#     }
# }
