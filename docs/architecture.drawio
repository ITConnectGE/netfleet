        <mxCell id="p5-la" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="100" as="sourcePoint"/><mxPoint x="140" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-lw" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="100" as="sourcePoint"/><mxPoint x="300" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-lapi" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="100" as="sourcePoint"/><mxPoint x="460" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-lu" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="100" as="sourcePoint"/><mxPoint x="620" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-lgh" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="100" as="sourcePoint"/><mxPoint x="780" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-lghcr" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="100" as="sourcePoint"/><mxPoint x="940" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-ld" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="100" as="sourcePoint"/><mxPoint x="1100" y="860" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-lpg" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="100" as="sourcePoint"/><mxPoint x="1260" y="860" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="p5-s1" value="1. Periodic check (every 1h)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-1a" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="170" as="sourcePoint"/><mxPoint x="780" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-1al" value="GET /repos/.../releases/latest" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-1a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-1b" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="200" as="sourcePoint"/><mxPoint x="620" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-1bl" value="{ tag: v1.2.0, body, prerelease: false }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-1b"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-s2" value="2. UI checks &amp; shows banner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-2a" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="270" as="sourcePoint"/><mxPoint x="460" y="270" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-2al" value="GET /api/v1/system/version" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-2a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-2b" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="295" as="sourcePoint"/><mxPoint x="620" y="295" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-2bl" value="(internal) GET /status" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-2b"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-2c" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="320" as="sourcePoint"/><mxPoint x="300" y="320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-2cl" value="{ current: v1.1.5, available: v1.2.0, changelog }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-2c"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-2d" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="345" as="sourcePoint"/><mxPoint x="140" y="345" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-2dl" value="banner: &quot;Update available v1.2.0&quot;" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-2d"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-s3" value="3. Admin triggers update" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-3a" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="410" as="sourcePoint"/><mxPoint x="300" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-3al" value="click [Update Now] (confirm backup)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-3a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-3b" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="435" as="sourcePoint"/><mxPoint x="460" y="435" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-3bl" value="POST /api/v1/system/update {version:v1.2.0}" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-3b"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-3c" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="460" as="sourcePoint"/><mxPoint x="620" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-3cl" value="POST /update (with INTERNAL_TOKEN)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-3c"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-s4" value="4. Updater: pre-flight + backup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="485" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-4a" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="525" as="sourcePoint"/><mxPoint x="1260" y="525" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-4al" value="pg_dump → /backups/pre-update-v1.2.0-2026-05-26.sql.gz" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-4a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-s5" value="5. Pull images + recreate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="555" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-5a" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="595" as="sourcePoint"/><mxPoint x="940" y="595" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-5al" value="docker pull mikrotik-central-{api,web}:v1.2.0" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-5a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-5b" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="625" as="sourcePoint"/><mxPoint x="1100" y="625" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-5bl" value="docker compose up -d (recreate api, web, worker)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-5b"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-s6" value="6. Alembic migration on api startup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="655" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-6a" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="695" as="sourcePoint"/><mxPoint x="1260" y="695" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-6al" value="alembic upgrade head" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-6a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-s7" value="7. Frontend polls updater /status (works even while api restarts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="725" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-7a" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="765" as="sourcePoint"/><mxPoint x="620" y="765" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-7al" value="GET /updater/status (every 2s)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-7a"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-7b" style="endArrow=classic;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="790" as="sourcePoint"/><mxPoint x="300" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p5-7bl" value="{ step: &apos;health-check&apos;, progress: 5/6, log: &apos;...&apos; }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p5-7b"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5-rb" value="On failure (any step 4-6) → Updater rolls back: re-tag previous images, pg_restore from backup, docker compose up -d → notify admin (email/webhook) → status=ROLLED_BACK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;dashed=1;align=left;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="815" width="1240" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


