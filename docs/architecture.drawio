        <mxCell id="p6-l1" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="100" as="sourcePoint"/><mxPoint x="120" y="860" as="targetPoint"/></mxGeometry></mxCell>
