  <diagram name="03-Authentication" id="page3">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" value="Authentication — Local (+TOTP)  &amp;  Entra ID OIDC" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3-h-user" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-h-web" value="web (Next.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-h-api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-h-db" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-h-entra" value="Entra ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p3-line-user" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="100" as="sourcePoint"/><mxPoint x="140" y="860" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="p3-line-web" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="100" as="sourcePoint"/><mxPoint x="360" y="860" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="p3-line-api" style="endArrow=none;dashed=1;html=1;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="100" as="sourcePoint"/><mxPoint x="600" y="860" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="p3-line-db" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="100" as="sourcePoint"/><mxPoint x="840" y="860" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="p3-line-entra" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="100" as="sourcePoint"/><mxPoint x="1080" y="860" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="p3-section-local" value="A. Local Authentication + TOTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3-l1" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="190" as="sourcePoint"/><mxPoint x="360" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l1-l" value="email + password" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l1"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l2" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="220" as="sourcePoint"/><mxPoint x="600" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l2-l" value="POST /auth/login" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l2"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l3" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="250" as="sourcePoint"/><mxPoint x="840" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l3-l" value="SELECT user, argon2 verify" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l3"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l4" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="280" as="sourcePoint"/><mxPoint x="600" y="280" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l4-l" value="user row + totp_secret" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l4"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l5" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="310" as="sourcePoint"/><mxPoint x="360" y="310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l5-l" value="200 { mfa_required: true, temp_token }" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l5"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l6" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="340" as="sourcePoint"/><mxPoint x="140" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l6-l" value="prompt: TOTP 6-digit" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l6"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l7" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="370" as="sourcePoint"/><mxPoint x="600" y="370" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l7-l" value="POST /auth/totp { code, temp_token }" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l7"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-l8" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="400" as="sourcePoint"/><mxPoint x="140" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-l8-l" value="200 { access_token (JWT), refresh_token }" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-l8"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-section-oidc" value="B. Entra ID OIDC (SSO + MFA enforced upstream)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3-o1" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="500" as="sourcePoint"/><mxPoint x="360" y="500" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o1-l" value="click &quot;Sign in with Microsoft&quot;" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o1"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o2" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="530" as="sourcePoint"/><mxPoint x="600" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o2-l" value="GET /auth/oidc/start" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o2"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o3" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="560" as="sourcePoint"/><mxPoint x="140" y="560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o3-l" value="302 redirect → login.microsoftonline.com (PKCE)" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o3"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o4" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="590" as="sourcePoint"/><mxPoint x="1080" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o4-l" value="authenticate + MFA (Authenticator app push/TOTP)" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o4"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o5" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="620" as="sourcePoint"/><mxPoint x="600" y="620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o5-l" value="callback?code=... (to /auth/oidc/callback)" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o5"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o6" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="650" as="sourcePoint"/><mxPoint x="1080" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o6-l" value="POST /token  (exchange code for id_token + access_token)" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o6"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o7" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="680" as="sourcePoint"/><mxPoint x="600" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o7-l" value="id_token { sub, email, name, groups }" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o7"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o8" style="endArrow=classic;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="710" as="sourcePoint"/><mxPoint x="840" y="710" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o8-l" value="UPSERT user (by sub), map groups → roles" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o8"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-o9" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="740" as="sourcePoint"/><mxPoint x="140" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3-o9-l" value="302 → /dashboard  + Set-Cookie: access_token (JWT)" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="p3-o9"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-note" value="Token strategy: api issues its own JWT after either flow (single auth model downstream).&#xa;Refresh tokens are httpOnly cookies. JWT carries: user_id, org_id, role_ids — not permissions (those are resolved live by Casbin)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;dashed=1;align=left;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="1100" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


  <diagram name="04-RBAC-Model" id="page4">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p4-title" value="RBAC — Data Model &amp; Casbin Policy Example" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p4-er-title" value="Entity-Relationship" style="text;html=1;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p4-org" value="Organization&#xa;(MSP itself)&#xa;―――――――――――&#xa;id, name, slug" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-user" value="User&#xa;―――――――――――&#xa;id, org_id, email,&#xa;password_hash,&#xa;totp_secret, oidc_sub,&#xa;is_active" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p4-site" value="Site&#xa;(MSP&apos;s client)&#xa;―――――――――――&#xa;id, org_id, name,&#xa;address, contact" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-device" value="Device (MikroTik)&#xa;―――――――――――&#xa;id, site_id, name,&#xa;host, port, transport,&#xa;creds_enc, model,&#xa;serial, last_seen,&#xa;status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p4-role" value="Role&#xa;―――――――――――&#xa;id, org_id, name,&#xa;description,&#xa;is_system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-assign" value="RoleAssignment&#xa;―――――――――――&#xa;id, user_id, role_id,&#xa;scope_type (site/device/*),&#xa;scope_id (nullable)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-perm" value="Permission&#xa;―――――――――――&#xa;id, role_id, section,&#xa;action (read/write/exec),&#xa;allow (bool)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="430" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-audit" value="AuditLog&#xa;―――――――――――&#xa;id, ts, user_id, device_id,&#xa;section, action, request,&#xa;outcome, ip, ua" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p4-r1" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-org" target="p4-user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r2" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-org" target="p4-site"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r3" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-site" target="p4-device"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r4" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-org" target="p4-role"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r5" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-user" target="p4-assign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r6" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-role" target="p4-assign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r7" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-role" target="p4-perm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r8" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-user" target="p4-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-r9" style="endArrow=ERmany;startArrow=ERone;html=1;" edge="1" parent="1" source="p4-device" target="p4-audit"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p4-cas-title" value="Casbin Policy — Example: &quot;DHCP-Manager&quot; role" style="text;html=1;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-cas-model" value="Model (RBAC with domains + section):&#xa;&#xa;[request_definition]&#xa;r = sub, dom, obj, act, section&#xa;&#xa;[policy_definition]&#xa;p = sub, dom, obj, act, section&#xa;&#xa;[role_definition]&#xa;g = _, _, _   ; user, role, scope&#xa;&#xa;[matchers]&#xa;m = g(r.sub, p.sub, r.dom) &amp;&amp;&#xa;    (p.obj == &quot;*&quot; || r.obj == p.obj) &amp;&amp;&#xa;    p.section == r.section &amp;&amp;&#xa;    p.act == r.act" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="500" height="280" as="geometry" />
        </mxCell>

        <mxCell id="p4-cas-policy" value="Policy rules:&#xa;&#xa;p, dhcp-manager, site:client-a, *, read, ip.dhcp&#xa;p, dhcp-manager, site:client-a, *, write, ip.dhcp&#xa;p, dhcp-manager, site:client-a, *, read, ip.firewall.nat&#xa;p, dhcp-manager, site:client-a, *, write, ip.firewall.nat&#xa;p, dhcp-manager, site:client-a, *, read, system.identity&#xa;&#xa;g, user:42, dhcp-manager, site:client-a&#xa;&#xa;Result: user 42 can manage DHCP &amp; NAT on every device of&#xa;site client-a, see system identity, nothing else." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6ffe6;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="400" width="500" height="240" as="geometry" />
        </mxCell>

        <mxCell id="p4-sections" value="Available sections (RouterOS-aligned)" style="text;html=1;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-sec-list" value="· system.*           (identity, resource, clock, reboot)&#xa;· interface.*        (ethernet, wireless, bridge, vlan)&#xa;· ip.address         · ip.route&#xa;· ip.dhcp            (server, lease, network)&#xa;· ip.firewall.filter · ip.firewall.nat · ip.firewall.mangle&#xa;· ip.pool            · ip.arp&#xa;· queue.simple       · queue.tree&#xa;· ppp.*              (secret, profile, active)&#xa;· user.*             (router user mgmt — admin only)&#xa;· tool.*             (ping, traceroute, fetch)&#xa;· file.*             (config backups, scripts)&#xa;· log.*              (read-only by default)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="500" height="220" as="geometry" />
        </mxCell>

        <mxCell id="p4-flow" value="Request flow: API receives call → resolves user roles from JWT → loads scope (site/device) → asks Casbin enforcer: enforce(sub, dom, obj, act, section) → allow/deny → audit log → execute or 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;dashed=1;align=left;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="660" width="770" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


