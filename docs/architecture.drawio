  <diagram name="02-Docker-Compose" id="page2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="Docker Compose — Services, Networks &amp; Volumes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p2-pub" value="Network: public  (only caddy exposes ports to host)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2-caddy" value="caddy&#xa;image: caddy:2-alpine&#xa;ports: 80:80, 443:443&#xa;volumes: caddy_data, caddy_config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2-int" value="Network: internal  (no host-mapped ports)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#d79b00;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1320" height="540" as="geometry" />
        </mxCell>

        <mxCell id="p2-web" value="web&#xa;image: ghcr.io/itconnectge/mikrotik-central-web:${VERSION}&#xa;env: NEXT_PUBLIC_API_URL&#xa;depends_on: api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2-api" value="api&#xa;image: ghcr.io/itconnectge/mikrotik-central-api:${VERSION}&#xa;env: DATABASE_URL, REDIS_URL, JWT_SECRET, OIDC_*&#xa;entrypoint: alembic upgrade head &amp;&amp; uvicorn&#xa;depends_on: postgres (healthy), redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p2-worker" value="worker&#xa;image: ghcr.io/itconnectge/mikrotik-central-api:${VERSION}&#xa;command: python -m app.workers.poller&#xa;env: same as api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="280" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2-updater" value="updater&#xa;image: ghcr.io/itconnectge/mikrotik-central-updater:stable&#xa;volumes:&#xa;  · /var/run/docker.sock:/var/run/docker.sock&#xa;  · /opt/mikrotik-central:/workdir&#xa;  · /opt/mikrotik-central/data/backups:/backups&#xa;env: UPDATE_CHANNEL, GITHUB_REPO, UPDATER_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="280" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p2-pg" value="postgres&#xa;image: postgres:16-alpine&#xa;env: POSTGRES_*&#xa;healthcheck: pg_isready" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=18;verticalAlign=top;spacingTop=10;size=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-pg-vol" value="bind mount&#xa;/opt/mikrotik-central/data/postgres" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2-redis" value="redis&#xa;image: redis:7-alpine&#xa;cmd: redis-server --appendonly yes" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=18;verticalAlign=top;spacingTop=10;size=15;" vertex="1" parent="1">
          <mxGeometry x="400" y="460" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-redis-vol" value="bind mount&#xa;/opt/mikrotik-central/data/redis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2-backups" value="backups&#xa;(host directory)&#xa;/opt/mikrotik-central/data/backups" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-backups-note" value="· pre-update pg_dump dumps here&#xa;· cron daily dumps + 30d retention&#xa;· accessible to host for rsync/S3 push" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="560" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2-cmd" value=".env  →  docker compose up -d  →  alembic migrations run on api startup  →  ready" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=12;" vertex="1" parent="1">
