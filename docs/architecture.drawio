        </mxCell>
        <mxCell id="p5-h-ghcr" value="ghcr.io" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
