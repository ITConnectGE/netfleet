        <mxCell id="p6-title" value="MikroTik API Proxy — &quot;IT Support views DHCP leases on Device X&quot;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
