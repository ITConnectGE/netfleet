# ============================================================
#  NetFleet — Environment Configuration
#  Copy this file to `.env` and edit. install.sh generates
#  the secrets automatically; you only need to set the rest.
# ============================================================

# ---------- Deployment ----------
NETFLEET_ENV=production
NETFLEET_DOMAIN=netfleet.example.com
NETFLEET_PUBLIC_URL=https://netfleet.example.com
VERSION=latest

# ---------- Secrets (autogenerated by install.sh) ----------
# Regenerate manually: openssl rand -hex 32
NETFLEET_JWT_SECRET=CHANGE_ME_32_BYTE_HEX
# Regenerate manually: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETFLEET_FERNET_KEY=CHANGE_ME_FERNET_KEY
# Shared internal token between api ↔ updater. openssl rand -hex 32
NETFLEET_UPDATER_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# ---------- Database (PostgreSQL) ----------
NETFLEET_DB_USER=netfleet
NETFLEET_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
NETFLEET_DB_NAME=netfleet
NETFLEET_DATABASE_URL=postgresql+asyncpg://netfleet:CHANGE_ME_STRONG_PASSWORD@postgres:5432/netfleet

# ---------- Redis ----------
NETFLEET_REDIS_URL=redis://redis:6379/0

# ---------- Authentication ----------
# Local auth is always on. To enable Microsoft Entra ID (or any OIDC) SSO, set ENABLED=true and fill below.
NETFLEET_OIDC_ENABLED=false
NETFLEET_OIDC_PROVIDER_NAME=Microsoft
NETFLEET_OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
NETFLEET_OIDC_CLIENT_ID=
NETFLEET_OIDC_CLIENT_SECRET=
NETFLEET_OIDC_REDIRECT_URI=https://netfleet.example.com/api/v1/auth/oidc/callback
NETFLEET_OIDC_SCOPES=openid profile email

# Session / JWT lifetimes (seconds)
NETFLEET_ACCESS_TOKEN_TTL=900            # 15 min
NETFLEET_REFRESH_TOKEN_TTL=2592000       # 30 days

# ---------- Updates ----------
NETFLEET_UPDATE_CHANNEL=stable           # stable | beta | manual
NETFLEET_GITHUB_REPO=ITConnectGE/netfleet
NETFLEET_AUTO_BACKUP_ON_UPDATE=true

# ---------- SMTP (invites, update notifications) ----------
NETFLEET_SMTP_ENABLED=false
NETFLEET_SMTP_HOST=
NETFLEET_SMTP_PORT=587
NETFLEET_SMTP_USER=
NETFLEET_SMTP_PASSWORD=
NETFLEET_SMTP_FROM=netfleet@example.com
NETFLEET_SMTP_TLS=true

# ---------- Workers ----------
NETFLEET_POLLER_INTERVAL_SECONDS=60
NETFLEET_POLLER_CONCURRENCY=16
NETFLEET_DEVICE_CONNECT_TIMEOUT=10
NETFLEET_DEVICE_READ_TIMEOUT=30

# ---------- Logging ----------
NETFLEET_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
NETFLEET_LOG_FORMAT=json                 # json | console

# ---------- CORS ----------
NETFLEET_CORS_ORIGINS=https://netfleet.example.com

# ---------- Frontend (Next.js public env) ----------
NEXT_PUBLIC_API_URL=https://netfleet.example.com/api/v1
NEXT_PUBLIC_APP_NAME=NetFleet
